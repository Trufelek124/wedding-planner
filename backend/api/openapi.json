{
  "components" : {
    "schemas" : {
      "AppInfo" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "version" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "version" ],
        "type" : "object"
      },
      "AuthConfig" : {
        "description" : "What a client needs to know before anyone has signed in.",
        "properties" : {
          "devLoginEnabled" : {
            "description" : "Whether the development login is available.",
            "type" : "boolean"
          },
          "googleClientId" : {
            "description" : "The Google OAuth client to sign in with; null when Google sign-in is not set up.",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "devLoginEnabled", "googleClientId" ],
        "type" : "object"
      },
      "Category" : {
        "description" : "A heading entries can be filed under, for example Venue.",
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "CategoryName" : {
        "properties" : {
          "name" : {
            "maxLength" : 60,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "DevSignInRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "Entry" : {
        "description" : "A plan item or a task.",
        "properties" : {
          "assigneeIds" : {
            "description" : "The members who do it: none, one or both.",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "categoryId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "completedAt" : {
            "description" : "When it was marked done; null otherwise.",
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "conflictsWithIds" : {
            "description" : "Those of dependsOnIds that end after this entry is meant to begin.",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "dependsOnIds" : {
            "description" : "The plan items this one waits for: it can only start when they are finished.",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          },
          "dueDate" : {
            "description" : "The day a task is due, or the day a plan item ends; null while not scheduled.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "kind" : {
            "enum" : [ "PLAN_ITEM", "TASK" ],
            "type" : "string"
          },
          "notes" : {
            "type" : "string"
          },
          "parentId" : {
            "description" : "Tasks only: the plan item it belongs to.",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "description" : "The level chosen by a person (MANUAL) or worked out for today (AUTO).",
            "enum" : [ "CRITICAL", "HIGH", "NORMAL", "LOW" ],
            "type" : "string"
          },
          "priorityMode" : {
            "enum" : [ "AUTO", "MANUAL" ],
            "type" : "string"
          },
          "priorityReason" : {
            "description" : "Why the entry has this level.",
            "enum" : [ "OVERDUE", "DUE_WITHIN_3_DAYS", "PAYMENT_DUE_WITHIN_7_DAYS", "DUE_WITHIN_14_DAYS", "NEEDED_BY_ANOTHER", "DUE_WITHIN_60_DAYS", "DUE_LATER", "NO_DATE", "SHOULD_HAVE_STARTED", "FINISHED", "SET_BY_HAND" ],
            "type" : "string"
          },
          "startDate" : {
            "description" : "Plan items only; null for a task.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "NOT_STARTED", "IN_PROGRESS", "DONE", "DROPPED" ],
            "type" : "string"
          },
          "taskCount" : {
            "description" : "For a plan item: how many tasks belong to it.",
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "version" : {
            "description" : "Send this back with a change; it tells whether someone else saved in between.",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "assigneeIds", "categoryId", "completedAt", "conflictsWithIds", "createdAt", "dependsOnIds", "dueDate", "id", "kind", "notes", "parentId", "priority", "priorityMode", "priorityReason", "startDate", "status", "taskCount", "title", "updatedAt", "version" ],
        "type" : "object"
      },
      "EntryChange" : {
        "description" : "All fields of an entry as they should be from now on.",
        "properties" : {
          "assigneeIds" : {
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 2,
            "minItems" : 0,
            "type" : "array"
          },
          "categoryId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "dueDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "notes" : {
            "maxLength" : 10000,
            "minLength" : 0,
            "type" : "string"
          },
          "parentId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "enum" : [ "CRITICAL", "HIGH", "NORMAL", "LOW" ],
            "type" : [ "string", "null" ]
          },
          "priorityMode" : {
            "enum" : [ "AUTO", "MANUAL" ],
            "type" : "string"
          },
          "startDate" : {
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "NOT_STARTED", "IN_PROGRESS", "DONE", "DROPPED" ],
            "type" : "string"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "version" : {
            "description" : "The version of the entry this change is based on.",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "assigneeIds", "categoryId", "dueDate", "notes", "parentId", "priority", "priorityMode", "startDate", "status", "title", "version" ],
        "type" : "object"
      },
      "EntryConversion" : {
        "properties" : {
          "kind" : {
            "description" : "What the entry should become.",
            "enum" : [ "PLAN_ITEM", "TASK" ],
            "type" : "string"
          }
        },
        "required" : [ "kind" ],
        "type" : "object"
      },
      "EntryStatusChange" : {
        "properties" : {
          "status" : {
            "enum" : [ "NOT_STARTED", "IN_PROGRESS", "DONE", "DROPPED" ],
            "type" : "string"
          }
        },
        "required" : [ "status" ],
        "type" : "object"
      },
      "GoogleSignInRequest" : {
        "properties" : {
          "idToken" : {
            "description" : "The ID token Google handed to the client.",
            "maxLength" : 8192,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "idToken" ],
        "type" : "object"
      },
      "Home" : {
        "description" : "What the first page shows: how long until the wedding, and what to do next.",
        "properties" : {
          "daysLeft" : {
            "description" : "Whole days from today to the wedding day: 0 on the day, negative after it; null while the day is not fixed.",
            "format" : "int64",
            "type" : [ "integer", "null" ]
          },
          "next" : {
            "description" : "The five unfinished entries to turn to next, by priority and then by date. Overdue entries are not repeated here.",
            "items" : {
              "$ref" : "#/components/schemas/Entry"
            },
            "type" : "array"
          },
          "overdue" : {
            "description" : "Every unfinished entry whose date has passed, the longest overdue first.",
            "items" : {
              "$ref" : "#/components/schemas/Entry"
            },
            "type" : "array"
          },
          "today" : {
            "description" : "Today's date where the wedding takes place.",
            "format" : "date",
            "type" : "string"
          },
          "weddingDate" : {
            "description" : "The wedding day; null while it is not fixed.",
            "format" : "date",
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "daysLeft", "next", "overdue", "today", "weddingDate" ],
        "type" : "object"
      },
      "Me" : {
        "description" : "The signed-in person.",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "id" ],
        "type" : "object"
      },
      "MemberName" : {
        "properties" : {
          "displayName" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "displayName" ],
        "type" : "object"
      },
      "NewEntry" : {
        "description" : "A plan item or a task to add.",
        "properties" : {
          "assigneeIds" : {
            "description" : "Who does it: none, one or both of the wedding's members.",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 2,
            "minItems" : 0,
            "type" : "array"
          },
          "categoryId" : {
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "dueDate" : {
            "description" : "The day a task is due, or the day a plan item ends.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "kind" : {
            "enum" : [ "PLAN_ITEM", "TASK" ],
            "type" : "string"
          },
          "notes" : {
            "description" : "Free text; may be empty.",
            "maxLength" : 10000,
            "minLength" : 0,
            "type" : "string"
          },
          "parentId" : {
            "description" : "Tasks only: the plan item this task belongs to.",
            "format" : "uuid",
            "type" : [ "string", "null" ]
          },
          "priority" : {
            "description" : "With priorityMode MANUAL: the chosen priority. With AUTO: null.",
            "enum" : [ "CRITICAL", "HIGH", "NORMAL", "LOW" ],
            "type" : [ "string", "null" ]
          },
          "priorityMode" : {
            "enum" : [ "AUTO", "MANUAL" ],
            "type" : "string"
          },
          "startDate" : {
            "description" : "Plan items only: the day the step starts. Needs a due date.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "enum" : [ "NOT_STARTED", "IN_PROGRESS", "DONE", "DROPPED" ],
            "type" : "string"
          },
          "title" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "assigneeIds", "categoryId", "dueDate", "kind", "notes", "parentId", "priority", "priorityMode", "startDate", "status", "title" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "An error, as RFC 9457 problem details.",
        "properties" : {
          "detail" : {
            "description" : "What went wrong this time, if there is more to say.",
            "type" : "string"
          },
          "fieldProblems" : {
            "description" : "For a request that is not valid: what is wrong with which field.",
            "items" : {
              "properties" : {
                "field" : {
                  "description" : "The field's name as the request spells it.",
                  "type" : "string"
                },
                "message" : {
                  "description" : "What is wrong, in words.",
                  "type" : "string"
                }
              },
              "required" : [ "field", "message" ],
              "type" : "object"
            },
            "type" : "array"
          },
          "instance" : {
            "description" : "The path that was asked for.",
            "type" : "string"
          },
          "status" : {
            "description" : "The HTTP status of the response.",
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "description" : "The kind of error in words.",
            "type" : "string"
          },
          "type" : {
            "description" : "The kind of error. Clients decide what to do from this value.",
            "enum" : [ "urn:wedding-planner:problem:bad-request", "urn:wedding-planner:problem:unauthenticated", "urn:wedding-planner:problem:forbidden", "urn:wedding-planner:problem:account-not-allowed", "urn:wedding-planner:problem:not-found", "urn:wedding-planner:problem:wedding-not-set-up", "urn:wedding-planner:problem:wedding-already-set-up", "urn:wedding-planner:problem:wedding-full", "urn:wedding-planner:problem:changed-meanwhile", "urn:wedding-planner:problem:entry-has-tasks", "urn:wedding-planner:problem:dependency-cycle", "urn:wedding-planner:problem:method-not-allowed", "urn:wedding-planner:problem:internal-error" ],
            "type" : "string",
            "x-enum-varnames" : [ "BAD_REQUEST", "UNAUTHENTICATED", "FORBIDDEN", "ACCOUNT_NOT_ALLOWED", "NOT_FOUND", "WEDDING_NOT_SET_UP", "WEDDING_ALREADY_SET_UP", "WEDDING_FULL", "CHANGED_MEANWHILE", "ENTRY_HAS_TASKS", "DEPENDENCY_CYCLE", "METHOD_NOT_ALLOWED", "INTERNAL_ERROR" ]
          }
        },
        "required" : [ "status", "title", "type" ],
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "description" : "The refresh token; a browser leaves it out, because its cookie carries it.",
            "maxLength" : 512,
            "minLength" : 0,
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "refreshToken" ],
        "type" : "object"
      },
      "Session" : {
        "description" : "What a client holds while someone is signed in.",
        "properties" : {
          "accessToken" : {
            "description" : "Sent with every request as 'Authorization: Bearer ...'.",
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "description" : "When the access token stops working; refresh before then.",
            "format" : "date-time",
            "type" : "string"
          },
          "refreshToken" : {
            "description" : "Exchanged for a new session when the access token expires; used once. Null for a browser: there it travels in a cookie that scripts cannot read.",
            "type" : [ "string", "null" ]
          },
          "user" : {
            "$ref" : "#/components/schemas/Me"
          }
        },
        "required" : [ "accessToken", "accessTokenExpiresAt", "refreshToken", "user" ],
        "type" : "object"
      },
      "Wedding" : {
        "properties" : {
          "currency" : {
            "type" : "string"
          },
          "date" : {
            "description" : "The wedding day; null while it is not fixed.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "members" : {
            "description" : "The two people, in the order of the setup.",
            "items" : {
              "$ref" : "#/components/schemas/WeddingMember"
            },
            "type" : "array"
          },
          "timeZone" : {
            "type" : "string"
          }
        },
        "required" : [ "currency", "date", "id", "members", "timeZone" ],
        "type" : "object"
      },
      "WeddingDetails" : {
        "properties" : {
          "currency" : {
            "minLength" : 1,
            "type" : "string"
          },
          "date" : {
            "description" : "The wedding day; null while it is not fixed.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "timeZone" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "currency", "date", "timeZone" ],
        "type" : "object"
      },
      "WeddingMember" : {
        "description" : "One of the two people the wedding belongs to.",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "signedIn" : {
            "description" : "Whether this person has signed in to the planner yet.",
            "type" : "boolean"
          },
          "you" : {
            "description" : "Whether this is the person asking.",
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "id", "signedIn", "you" ],
        "type" : "object"
      },
      "WeddingSetup" : {
        "description" : "The first owner's answers at the setup.",
        "properties" : {
          "currency" : {
            "description" : "ISO 4217 code of the currency all amounts are in, for example PLN.",
            "minLength" : 1,
            "type" : "string"
          },
          "date" : {
            "description" : "The wedding day; null while it is not fixed.",
            "format" : "date",
            "type" : [ "string", "null" ]
          },
          "partnerName" : {
            "description" : "What the planner calls the other person.",
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          },
          "timeZone" : {
            "description" : "IANA time zone the wedding's dates are read in, for example Europe/Warsaw.",
            "minLength" : 1,
            "type" : "string"
          },
          "yourName" : {
            "description" : "What the planner calls the person setting it up.",
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "currency", "date", "partnerName", "timeZone", "yourName" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "Wedding planner API",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/app-info" : {
      "get" : {
        "operationId" : "appInfo",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppInfo"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "app-info-controller" ]
      }
    },
    "/api/auth/config" : {
      "get" : {
        "operationId" : "config",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuthConfig"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/dev" : {
      "post" : {
        "operationId" : "dev",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DevSignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "dev-login-controller" ]
      }
    },
    "/api/auth/google" : {
      "post" : {
        "operationId" : "google",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/GoogleSignInRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "operationId" : "refresh",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "wp_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/sign-out" : {
      "post" : {
        "operationId" : "signOut",
        "parameters" : [ {
          "in" : "cookie",
          "name" : "wp_refresh",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error."
          }
        },
        "tags" : [ "auth-controller" ]
      }
