# Copy to deploy/.env and fill in. The file with values never goes into the repository.
# What each one means is in docs/deployment.md.

DATABASE_USER=
DATABASE_PASSWORD=
APP_JWT_SECRET=
ALLOWED_EMAILS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
DEV_LOGIN_ENABLED=false

# The e-mail import. Off until all three are filled in (and the client id above).
GOOGLE_OAUTH_CLIENT_SECRET=
APP_PUBLIC_URL=
APP_MAIL_TOKEN_KEY=

# Reading the mail with the AI service. Off until the key is filled in.
APP_AI_API_KEY=

# Optional, each with a starting value in the server: take the # away to set one.
# MAIL_READING_MONTHLY_LIMIT_USD=20
# MAIL_READING_DAILY_MESSAGES=2000
# MAIL_READING_DAILY_SUGGESTIONS=50
# MAIL_READING_TRIAGE_SURE=60
# MAIL_READING_INTERVAL=1m
# MAIL_READING_ENABLED=true
# MAIL_SYNC_INTERVAL=5m
# MAIL_SYNC_ENABLED=true
# APP_AI_TRIAGE_MODEL=claude-haiku-5-5
# APP_AI_EXTRACTION_MODEL=claude-opus-5-5
# APP_AI_TRIAGE_PRICE_IN=0.10
# APP_AI_TRIAGE_PRICE_OUT=0.50
# APP_AI_EXTRACTION_PRICE_IN=4
# APP_AI_EXTRACTION_PRICE_OUT=20
# PREVIEWS_ENABLED=true

# Only when running a published image instead of building one here:
# IMAGE=
# IMAGE_TAG=
