# Copy to deploy/.env and fill in. The file with values never goes into the repository.
# What each one means is in docs/deployment.md.

DATABASE_USER=
DATABASE_PASSWORD=
APP_JWT_SECRET=
ALLOWED_EMAILS=
GOOGLE_OAUTH_WEB_CLIENT_ID=
DEV_LOGIN_ENABLED=false

# Only when running a published image instead of building one here:
# IMAGE=
# IMAGE_TAG=
